---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatMonthDay } from "../../utils/format";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const groupedByYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.data.pubDate.getFullYear();
  const list = groupedByYear.get(year) ?? [];
  list.push(note);
  groupedByYear.set(year, list);
}
const years = Array.from(groupedByYear.entries()).sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="随笔" description="Reeve Reed 的随笔与记录。">
  <section class="subpage-hero-crimson">
    <div class="container subpage-hero-row">
      <h1 class="hero-h1 subpage-h1">
        <span class="hero-h1-line"><span>Selected <em>Notes</em></span></span>
      </h1>
      <a class="subpage-rss-link" href="/rss.xml">RSS ↗</a>
    </div>
  </section>

  <div class="paper-shell" data-paper-zone>
    <section class="paper-section notes-archive-section">
      <div class="container">
        {
          years.map(([year, items]) => (
            <section class="notes-year-group" data-reveal aria-label={`${year} 年随笔`}>
              <h2 class="notes-year-heading">{year}</h2>
              <ul class="note-ledger">
                {items.map((note) => (
                  <li class="note-ledger-item">
                    <a
                      class="note-ledger-link"
                      href={`/notes/${note.id}/`}
                    >
                      <span class="note-ledger-title">{note.data.title}</span>
                      <time
                        class="note-ledger-date"
                        datetime={note.data.pubDate.toISOString()}
                      >
                        {formatMonthDay(note.data.pubDate)}
                      </time>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
