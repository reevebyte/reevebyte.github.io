---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatFullDate } from "../../utils/format";

export async function getStaticPaths() {
  const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      newer: index > 0 ? notes[index - 1] : null,
      older: index < notes.length - 1 ? notes[index + 1] : null,
    },
  }));
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <section class="subpage-hero-crimson">
    <div class="container article-hero-inner">
      <a class="article-back-link" href="/notes/">← 返回随笔</a>
      <h1 class="hero-h1 article-h1">{note.data.title}</h1>
      <time class="article-date" datetime={note.data.pubDate.toISOString()}>
        {formatFullDate(note.data.pubDate)}
      </time>
    </div>
  </section>

  <div class="paper-shell" data-paper-zone>
    <div class="container">
      <article class="article-body-wrap">
        <div class="prose">
          <Content />
        </div>

        {
          (newer || older) && (
            <nav class="article-pager" aria-label="相邻文章">
              <div>
                {newer && (
                  <a class="link-crimson" href={`/notes/${newer.id}/`}>
                    ← {newer.data.title}
                  </a>
                )}
              </div>
              <div>
                {older && (
                  <a class="link-crimson" href={`/notes/${older.id}/`}>
                    {older.data.title} →
                  </a>
                )}
              </div>
            </nav>
          )
        }
      </article>
    </div>
  </div>
</BaseLayout>
