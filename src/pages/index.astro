---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";
---

<BaseLayout>
  <!-- SECTION 1: FULL-BLEED 50/50 SPLIT VENETIAN CRIMSON × MUSEUM OIL PAINTING -->
  <section class="hero-split" data-hero-section aria-labelledby="hero-heading">
    <div class="hero-split-left">
      <div class="hero-split-copy" data-hero-copy>
        <h1 id="hero-heading" class="hero-h1">
          <span class="hero-h1-line"><span>Tools Built</span></span>
          <span class="hero-h1-line"><span>to Last &amp;</span></span>
          <span class="hero-h1-line"><span><em>Feel Sharp</em></span></span>
        </h1>

        <p class="hero-sub">Reeve Reed 的个人主页 — 写工具，也做界面。</p>

        <div class="hero-btn-row">
          <a
            class="btn-ivory"
            href="/projects/#screentranslate"
            data-magnetic
          >
            <span>查看作品</span>
            <span>→</span>
          </a>
          <a
            class="btn-crimson-ghost"
            href={SITE.github}
            target="_blank"
            rel="noreferrer"
            data-magnetic
          >
            <span>GitHub ↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-split-right">
      <img
        class="hero-split-art"
        data-hero-art
        src="/art/hero-study.webp"
        alt="安托内洛·达·梅西纳约 1475 年《书房中的圣哲罗姆》，伦敦国家美术馆馆藏"
        width="1200"
        height="1522"
        fetchpriority="high"
        decoding="async"
      />
      <p class="hero-split-credit">
        <em>Saint Jerome in His Study</em> — Antonello da Messina, c. 1475
      </p>
    </div>
  </section>

  <!-- SECTION 2: FULL-BLEED ARCHIVAL IVORY GALLERY -->
  <div class="paper-shell" data-paper-zone>
    <section class="paper-section home-gallery-section" aria-labelledby="works-heading">
      <div class="container">
        <div class="oswald-heading-row" data-reveal>
          <h2 id="works-heading" class="oswald-h2">
            <span>Selected <em>Craft</em></span>
          </h2>
          <a class="link-crimson" href="/projects/">全部作品 →</a>
        </div>

        <div class="masterpiece-grid">
          <article class="masterpiece-col" data-reveal data-col-parallax="-14">
            <div class="art-plate-wrap">
              <a
                class="art-plate grade-baroque"
                href="/projects/#screentranslate"
                data-tilt-card
                data-curtain-plate
                aria-label="查看 ScreenTranslate"
              >
                <img
                  src="/art/museum-cosmos.webp"
                  alt="塞拉里乌斯 1660 年《和谐大宇宙》巴洛克星图"
                  decoding="async"
                />
                <div class="art-plaque">
                  <span><em>Harmonia Macrocosmica</em>, Cellarius</span>
                  <span>1660</span>
                </div>
              </a>
            </div>
            <div class="gallery-caption">
              <h3 class="feature-title">
                <a href="/projects/#screentranslate">ScreenTranslate</a>
              </h3>
              <span class="gallery-sub">跨平台截图翻译</span>
            </div>
          </article>

          <article class="masterpiece-col" data-reveal style="transition-delay: 90ms;">
            <div class="art-plate-wrap">
              <a
                class="art-plate grade-sanguine"
                href="/projects/"
                data-tilt-card
                data-curtain-plate
                style="transition-delay: 110ms;"
                aria-label="查看作品清单"
              >
                <img
                  src="/art/museum-craft.webp"
                  alt="丢勒 1514 年《忧郁 I》红粉笔色调铜版画"
                  decoding="async"
                />
                <div class="art-plaque">
                  <span><em>Melencolia I</em>, Albrecht Dürer</span>
                  <span>1514</span>
                </div>
              </a>
            </div>
            <div class="gallery-caption">
              <h3 class="feature-title">
                <a href="/projects/">Interface</a>
              </h3>
              <span class="gallery-sub">界面与排版</span>
            </div>
          </article>

          <article
            class="masterpiece-col"
            data-reveal
            data-col-parallax="14"
            style="transition-delay: 180ms;"
          >
            <div class="art-plate-wrap">
              <a
                class="art-plate grade-oxblood"
                href="/notes/"
                data-tilt-card
                data-curtain-plate
                style="transition-delay: 220ms;"
                aria-label="阅读随笔"
              >
                <img
                  src="/art/museum-arch.webp"
                  alt="皮拉内西 1750 年《想象的监狱》建筑蚀刻版画"
                  decoding="async"
                />
                <div class="art-plaque">
                  <span><em>Le Carceri</em>, G. B. Piranesi</span>
                  <span>1750</span>
                </div>
              </a>
            </div>
            <div class="gallery-caption">
              <h3 class="feature-title">
                <a href="/notes/">Notes</a>
              </h3>
              <span class="gallery-sub">脚本与随笔</span>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
