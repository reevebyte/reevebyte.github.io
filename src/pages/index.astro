---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TelemetryWidget from "../components/TelemetryWidget.astro";
import ScreenTranslateDemo from "../components/ScreenTranslateDemo.astro";
import { SITE } from "../data/site";
import { formatYearMonth } from "../utils/format";

const recentNotes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <section class="hero-section" aria-labelledby="hero-heading">
    <div>
      <h1 id="hero-heading" class="hero-title">
        <span class="mask-line"><span>{SITE.author}</span></span>
      </h1>

      <p class="hero-tagline">
        <span class="mask-line mask-delay-1"><span>{SITE.tagline}</span></span>
      </p>

      <p class="hero-bio">
        <span class="mask-line mask-delay-2"><span>{SITE.bio}</span></span>
      </p>

      <div class="action-row" aria-label="快捷入口">
        <a class="btn btn-primary" href="/projects/">查看作品</a>
        <button
          type="button"
          class="btn btn-outline"
          data-copy-email={SITE.email}
          title="点击复制邮箱地址"
        >
          {SITE.email}
        </button>
        <a
          class="text-link"
          href={SITE.github}
          target="_blank"
          rel="noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </div>

    <TelemetryWidget />
  </section>

  <ScreenTranslateDemo />

  <section class="band" data-reveal aria-labelledby="notes-heading">
    <div class="band-head">
      <h2 id="notes-heading" class="band-title">随笔</h2>
      <a class="text-link" href="/notes/">全部随笔 →</a>
    </div>

    <ul class="note-list">
      {
        recentNotes.map((note) => (
          <li class="note-item">
            <a class="note-link" href={`/notes/${note.id}/`}>
              <div>
                <p class="note-title">
                  <span>{note.data.title}</span>
                  <span class="note-arrow" aria-hidden="true">→</span>
                </p>
                <p class="note-desc">{note.data.description}</p>
              </div>
              <time class="note-date" datetime={note.data.pubDate.toISOString()}>
                {formatYearMonth(note.data.pubDate)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="now" class="band" data-reveal aria-label="近况与常用">
    <div class="two-col">
      <div>
        <h2 class="col-heading">近况</h2>
        <div class="clean-paragraphs">
          {SITE.now.map((item) => <p>{item}</p>)}
        </div>
      </div>

      <div>
        <h2 class="col-heading">常用技术与工具</h2>
        <p class="stack-flow">
          {
            SITE.toolbox.map((tool, index) => (
              <>
                {index > 0 && <span class="stack-sep" aria-hidden="true">·</span>}
                <span>{tool}</span>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
