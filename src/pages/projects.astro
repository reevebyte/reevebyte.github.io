---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScreenTranslateDemo from "../components/ScreenTranslateDemo.astro";
import { PROJECTS } from "../data/projects";
---

<BaseLayout title="作品" description="ReeveByte 的开源工具与站点。">
  <section class="subpage-hero-crimson">
    <div class="container subpage-hero-row">
      <h1 class="hero-h1 subpage-h1">
        <span class="hero-h1-line"><span>Selected <em>Projects</em></span></span>
      </h1>
    </div>
  </section>

  <div class="paper-shell" data-paper-zone>
    <section class="paper-section">
      <div class="container">
        <div class="project-gallery">
          {
            PROJECTS.map((project, idx) => (
              <article
                class:list={["project-showcase", idx % 2 === 1 && "is-reversed"]}
                data-reveal
              >
                <div class="project-media-col">
                  <div class="art-plate-wrap">
                    <a
                      class="art-plate project-plate"
                      href={project.repoUrl}
                      target="_blank"
                      rel="noreferrer"
                      data-tilt-card
                      data-curtain-plate
                      aria-label={`查看 ${project.name} 源码`}
                    >
                      <img
                        src={project.image}
                        alt={project.imageAlt}
                        decoding="async"
                      />
                      <div class="art-plaque">
                        <span>
                          <em>{project.artTitle}</em>, {project.artArtist}
                        </span>
                        <span>{project.artYear}</span>
                      </div>
                    </a>
                  </div>
                </div>

                <div class="project-info-col">
                  <p class="project-index">0{idx + 1} — {project.year}</p>
                  <h2 class="feature-title project-title">
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {project.name}
                    </a>
                  </h2>

                  <p class="project-lead">{project.summary}</p>

                  <div class="project-actions">
                    <a
                      class="btn-crimson"
                      href={project.repoUrl}
                      target="_blank"
                      rel="noreferrer"
                      data-magnetic
                    >
                      查看源码 ↗
                    </a>
                    {project.demoUrl && (
                      <a
                        class="link-crimson"
                        href={project.demoUrl}
                        target="_blank"
                        rel="noreferrer"
                      >
                        在线访问 ↗
                      </a>
                    )}
                    {idx === 0 && (
                      <a
                        class="link-crimson"
                        href="#screentranslate"
                      >
                        实时演示 ↓
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <div class="container"><hr class="paper-divider" data-draw /></div>

    <ScreenTranslateDemo />
  </div>
</BaseLayout>
