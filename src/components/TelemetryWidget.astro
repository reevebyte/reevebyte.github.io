<div class="clock-piece" aria-label="北京时间实时时钟">
  <svg class="clock-face" viewBox="0 0 120 120" aria-hidden="true">
    <circle
      cx="60"
      cy="60"
      r="56"
      fill="var(--surface)"
      stroke="var(--line-strong)"
      stroke-width="1.2"
    />
    <g stroke="var(--line-strong)" stroke-width="1.4" stroke-linecap="round">
      <line x1="60" y1="10" x2="60" y2="18" />
      <line x1="110" y1="60" x2="102" y2="60" />
      <line x1="60" y1="110" x2="60" y2="102" />
      <line x1="10" y1="60" x2="18" y2="60" />
    </g>
    <g stroke="var(--line)" stroke-width="1.2" stroke-linecap="round">
      <line x1="85" y1="16.7" x2="82.5" y2="21" />
      <line x1="103.3" y1="35" x2="99" y2="37.5" />
      <line x1="103.3" y1="85" x2="99" y2="82.5" />
      <line x1="85" y1="103.3" x2="82.5" y2="99" />
      <line x1="35" y1="103.3" x2="37.5" y2="99" />
      <line x1="16.7" y1="85" x2="21" y2="82.5" />
      <line x1="16.7" y1="35" x2="21" y2="37.5" />
      <line x1="35" y1="16.7" x2="37.5" y2="21" />
    </g>
    <line
      data-hand-hour
      x1="60"
      y1="60"
      x2="60"
      y2="32"
      stroke="var(--ink)"
      stroke-width="3.2"
      stroke-linecap="round"
    />
    <line
      data-hand-min
      x1="60"
      y1="60"
      x2="60"
      y2="21"
      stroke="var(--ink)"
      stroke-width="2.2"
      stroke-linecap="round"
    />
    <line
      data-hand-sec
      x1="60"
      y1="70"
      x2="60"
      y2="18"
      stroke="var(--accent)"
      stroke-width="1.4"
      stroke-linecap="round"
    />
    <circle cx="60" cy="60" r="3.4" fill="var(--accent)" />
  </svg>
  <span class="clock-caption" data-clock-time>北京 --:--</span>
</div>

<script>
  function initClock() {
    const timeEl = document.querySelector<HTMLElement>("[data-clock-time]");
    const hHand = document.querySelector<SVGLineElement>("[data-hand-hour]");
    const mHand = document.querySelector<SVGLineElement>("[data-hand-min]");
    const sHand = document.querySelector<SVGLineElement>("[data-hand-sec]");

    const win = window as unknown as { __reeveClockTimer?: number };
    if (win.__reeveClockTimer) {
      window.clearInterval(win.__reeveClockTimer);
    }

    if (!timeEl) return;

    const timeFmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Shanghai",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    const tick = () => {
      const t = timeFmt.format(new Date());
      const [hh, mm, ss] = t.split(":").map(Number);
      timeEl.textContent = `北京 ${String(hh).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;

      const sDeg = ss * 6;
      const mDeg = mm * 6 + ss * 0.1;
      const hDeg = (hh % 12) * 30 + mm * 0.5;
      hHand?.setAttribute("transform", `rotate(${hDeg} 60 60)`);
      mHand?.setAttribute("transform", `rotate(${mDeg} 60 60)`);
      sHand?.setAttribute("transform", `rotate(${sDeg} 60 60)`);
    };

    tick();
    win.__reeveClockTimer = window.setInterval(tick, 1000);
  }

  initClock();
  document.addEventListener("astro:page-load", initClock);
</script>
