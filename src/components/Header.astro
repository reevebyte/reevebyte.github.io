---
import { SITE } from "../data/site";

const pathname = Astro.url.pathname;
const isProjects = pathname.startsWith("/projects");
const isNotes = pathname.startsWith("/notes");
---

<header class="site-header" data-site-header>
  <div class="container header-bar">
    <nav class="header-left" aria-label="左侧导航">
      <a class="nav-link" class:list={{ "is-active": isProjects }} href="/projects/">
        作品
      </a>
      <a class="nav-link" class:list={{ "is-active": isNotes }} href="/notes/">
        随笔
      </a>
    </nav>

    <a class="center-brand" href="/" aria-label={`${SITE.title} 首页`}>
      <span class="brand-text">{SITE.title}</span>
      <svg
        class="brand-star"
        viewBox="0 0 36 36"
        fill="none"
        stroke="currentColor"
        stroke-width="1.35"
        aria-hidden="true"
      >
        <circle cx="18" cy="18" r="15" stroke-dasharray="2 3" stroke-opacity="0.55" />
        <path d="M18 4 L21 15 L32 18 L21 21 L18 32 L15 21 L4 18 L15 15 Z" />
        <circle cx="18" cy="18" r="2.2" fill="currentColor" stroke="none" />
      </svg>
    </a>

    <div class="header-right">
      <button
        type="button"
        class="header-cta"
        data-copy-email={SITE.email}
        data-magnetic
        data-cursor="COPY"
        title="点击复制邮箱地址"
      >
        联系我
      </button>
    </div>
  </div>
</header>
