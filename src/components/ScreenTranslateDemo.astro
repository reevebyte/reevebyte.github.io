---
import { PROJECTS } from "../data/projects";

const mainProject = PROJECTS[0];
---

<section class="paper-section" id="screentranslate" aria-labelledby="bp-heading">
  <div class="container">
    <div class="blueprint-grid">
      <div data-reveal>
        <h2 id="bp-heading" class="oswald-h2">
          <span>ScreenTranslate</span>
        </h2>

        <p style="margin: 1.15rem 0 1.85rem; color: var(--ink-paper-2); font-size: 1.05rem; line-height: 1.8;">
          框选屏幕任意区域即可识别文字并原位显示译文，支持 Windows 与 macOS。
        </p>

        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.35rem;">
          <a
            class="btn-crimson"
            href={mainProject.repoUrl}
            target="_blank"
            rel="noreferrer"
            data-magnetic
            data-cursor="GITHUB"
          >
            查看源码 ↗
          </a>
          <a class="link-crimson" href="/" data-cursor="OPEN">← 返回首页</a>
        </div>
      </div>

      <div class="blueprint-console" data-ocr-demo data-reveal>
        <div class="blueprint-bar">
          <div class="blueprint-tabs" role="tablist" aria-label="演示语种切换">
            <button
              type="button"
              class="blueprint-tab is-active"
              data-lang-btn="en"
              role="tab"
              aria-selected="true"
            >
              :EN → ZH:
            </button>
            <button
              type="button"
              class="blueprint-tab"
              data-lang-btn="ja"
              role="tab"
              aria-selected="false"
            >
              :JA → ZH:
            </button>
          </div>

          <button type="button" class="blueprint-scan-btn" data-scan-trigger>
            框选扫描
          </button>
        </div>

        <div class="blueprint-body">
          <button
            type="button"
            class="bp-target"
            data-ocr-target="0"
            data-cursor="SCAN"
            aria-label="点击扫描翻译第一段"
          >
            <span class="bp-beam" aria-hidden="true"></span>
            <p class="bp-source" data-source-text>
              Select any region on your screen to capture text with local OCR and render translated overlays right in place.
            </p>
            <div class="bp-overlay" aria-live="polite" data-translated-text>
              框选屏幕任意区域即可通过本地 OCR 识别文字，并在原位直接渲染悬浮译文。
            </div>
          </button>

          <button
            type="button"
            class="bp-target"
            data-ocr-target="1"
            data-cursor="SCAN"
            aria-label="点击扫描翻译第二段"
          >
            <span class="bp-beam" aria-hidden="true"></span>
            <p class="bp-source" data-source-text>
              Switch seamlessly between offline recognition, OpenAI-compatible models, and side-by-side reading mode.
            </p>
            <div class="bp-overlay" aria-live="polite" data-translated-text>
              在离线识别、OpenAI 兼容大模型与对照阅读视图之间无缝切换。
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const PRESETS = {
    en: [
      {
        source:
          "Select any region on your screen to capture text with local OCR and render translated overlays right in place.",
        translated:
          "框选屏幕任意区域即可通过本地 OCR 识别文字，并在原位直接渲染悬浮译文。",
      },
      {
        source:
          "Switch seamlessly between offline recognition, OpenAI-compatible models, and side-by-side reading mode.",
        translated:
          "在离线识别、OpenAI 兼容大模型与对照阅读视图之间无缝切换。",
      },
    ],
    ja: [
      {
        source:
          "画面上の任意のエリアをドラッグして選択すると、文字を自動認識して翻訳結果をそのまま重ねて表示します。",
        translated:
          "拖拽框选屏幕任意区域，程序会自动识别文字并将翻译结果直接叠加显示在原处。",
      },
      {
        source:
          "グローバルショートカットに対応し、作業中のウィンドウを離れずに素早く翻訳できます。",
        translated:
          "支持全局快捷键，无需离开当前工作窗口即可快速完成翻译。",
      },
    ],
  } as const;

  function initCrimsonDemo() {
    const root = document.querySelector<HTMLElement>("[data-ocr-demo]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";

    let currentLang: "en" | "ja" = "en";
    let activeIdx = 0;
    let scanTimer: number | undefined;
    let typeTimer: number | undefined;

    const langBtns = root.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
    const targets = root.querySelectorAll<HTMLButtonElement>("[data-ocr-target]");
    const triggerBtn = root.querySelector<HTMLButtonElement>("[data-scan-trigger]");

    function renderPreset(lang: "en" | "ja") {
      currentLang = lang;
      const items = PRESETS[lang];
      targets.forEach((target, idx) => {
        const item = items[idx];
        const src = target.querySelector("[data-source-text]");
        const tr = target.querySelector("[data-translated-text]");
        if (src) src.textContent = item.source;
        if (tr) tr.textContent = item.translated;
      });

      langBtns.forEach((btn) => {
        const isCurrent = btn.dataset.langBtn === lang;
        btn.classList.toggle("is-active", isCurrent);
        btn.setAttribute("aria-selected", String(isCurrent));
      });
    }

    function runScan(idx: number) {
      activeIdx = idx;
      window.clearTimeout(scanTimer);
      window.clearInterval(typeTimer);

      targets.forEach((t) => {
        t.classList.remove("is-selected", "is-scanning", "is-translated");
      });

      const target = targets[idx];
      if (!target) return;

      target.classList.add("is-selected");
      void target.offsetWidth;
      target.classList.add("is-scanning");

      const fullText = PRESETS[currentLang][idx].translated;
      const outEl = target.querySelector<HTMLElement>("[data-translated-text]");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      scanTimer = window.setTimeout(
        () => {
          target.classList.remove("is-scanning");
          target.classList.add("is-translated");
          if (!outEl) return;
          if (reduced) {
            outEl.textContent = fullText;
            return;
          }
          let cursor = 0;
          outEl.textContent = "";
          typeTimer = window.setInterval(() => {
            cursor += 2;
            outEl.textContent = fullText.slice(0, cursor);
            if (cursor >= fullText.length) {
              window.clearInterval(typeTimer);
            }
          }, 18);
        },
        reduced ? 40 : 420
      );
    }

    langBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.dataset.langBtn === "ja" ? "ja" : "en";
        renderPreset(lang);
        runScan(activeIdx);
      });
    });

    targets.forEach((target, idx) => {
      target.addEventListener("click", () => runScan(idx));
    });

    triggerBtn?.addEventListener("click", () => {
      runScan((activeIdx + 1) % targets.length);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          window.setTimeout(() => runScan(0), 400);
        }
      },
      { threshold: 0.25 }
    );
    observer.observe(root);
  }

  initCrimsonDemo();
  document.addEventListener("astro:page-load", initCrimsonDemo);
</script>
