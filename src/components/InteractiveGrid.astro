<canvas
  id="grid-canvas"
  class="grid-canvas"
  aria-hidden="true"
  transition:persist="interactive-grid"
></canvas>

<script>
  (() => {
    const win = window as unknown as { __reeveGridInit?: boolean };
    if (win.__reeveGridInit) return;
    win.__reeveGridInit = true;

    const canvas = document.getElementById("grid-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const coarsePointer = window.matchMedia("(pointer: coarse)");

    const SPACING = 34;
    const RADIUS = 145;
    const MAX_SHIFT = 10;

    interface Dot {
      ox: number;
      oy: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      heat: number;
    }

    let width = 0;
    let height = 0;
    let dpr = 1;
    let dots: Dot[] = [];
    const pointer = { x: -9999, y: -9999, active: false };
    let rafId = 0;

    function buildGrid() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      const offsetX = (width % SPACING) / 2;
      const offsetY = (height % SPACING) / 2;
      for (let y = offsetY; y <= height; y += SPACING) {
        for (let x = offsetX; x <= width; x += SPACING) {
          dots.push({ ox: x, oy: y, x, y, vx: 0, vy: 0, heat: 0 });
        }
      }
      drawStatic();
    }

    function getColors() {
      const dark = document.documentElement.dataset.theme === "dark";
      return {
        base: dark ? [245, 244, 240, 0.14] : [17, 17, 16, 0.13],
        accent: dark ? [255, 92, 26] : [255, 77, 0],
      };
    }

    function drawStatic() {
      const { base } = getColors();
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = `rgba(${base[0]}, ${base[1]}, ${base[2]}, ${base[3]})`;
      for (let i = 0; i < dots.length; i++) {
        const d = dots[i];
        ctx!.fillRect(d.ox - 0.75, d.oy - 0.75, 1.5, 1.5);
      }
    }

    function step() {
      const { base, accent } = getColors();
      ctx!.clearRect(0, 0, width, height);

      let moving = false;

      for (let i = 0; i < dots.length; i++) {
        const d = dots[i];
        let tx = d.ox;
        let ty = d.oy;
        let targetHeat = 0;

        if (pointer.active) {
          const dx = d.ox - pointer.x;
          const dy = d.oy - pointer.y;
          const distSq = dx * dx + dy * dy;
          if (distSq < RADIUS * RADIUS && distSq > 0.001) {
            const dist = Math.sqrt(distSq);
            const force = (1 - dist / RADIUS) ** 2;
            tx = d.ox + (dx / dist) * force * MAX_SHIFT;
            ty = d.oy + (dy / dist) * force * MAX_SHIFT;
            targetHeat = force;
          }
        }

        d.vx = (d.vx + (tx - d.x) * 0.16) * 0.74;
        d.vy = (d.vy + (ty - d.y) * 0.16) * 0.74;
        d.x += d.vx;
        d.y += d.vy;
        d.heat += (targetHeat - d.heat) * 0.14;

        if (
          Math.abs(d.vx) > 0.01 ||
          Math.abs(d.vy) > 0.01 ||
          Math.abs(d.x - d.ox) > 0.05 ||
          Math.abs(d.y - d.oy) > 0.05 ||
          d.heat > 0.01
        ) {
          moving = true;
        }

        if (d.heat > 0.02) {
          const alpha = base[3] + d.heat * 0.62;
          const r = Math.round(base[0] + (accent[0] - base[0]) * d.heat);
          const g = Math.round(base[1] + (accent[1] - base[1]) * d.heat);
          const b = Math.round(base[2] + (accent[2] - base[2]) * d.heat);
          const size = 1.5 + d.heat * 1.4;
          ctx!.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;
          ctx!.fillRect(d.x - size / 2, d.y - size / 2, size, size);
        } else {
          ctx!.fillStyle = `rgba(${base[0]}, ${base[1]}, ${base[2]}, ${base[3]})`;
          ctx!.fillRect(d.x - 0.75, d.y - 0.75, 1.5, 1.5);
        }
      }

      if (moving || pointer.active) {
        rafId = window.requestAnimationFrame(step);
      } else {
        rafId = 0;
      }
    }

    function kick() {
      if (reducedMotion.matches || coarsePointer.matches) {
        drawStatic();
        return;
      }
      if (!rafId) {
        rafId = window.requestAnimationFrame(step);
      }
    }

    window.addEventListener(
      "pointermove",
      (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.active = true;
        kick();
      },
      { passive: true }
    );

    window.addEventListener("pointerleave", () => {
      pointer.active = false;
      kick();
    });

    window.addEventListener("resize", buildGrid, { passive: true });
    document.addEventListener("reeve:theme-change", () => {
      if (!rafId) drawStatic();
    });

    buildGrid();
  })();
</script>
